@@ -0,0 +1,102 @@
+import json
+import logging
+import os
+import threading
+import time
+
+from .base import LLM, Schema
+
+logger = logging.getLogger(__name__)
+
+#: Optional JSONL file every call's token usage is appended to, one line per call,
+#: so a run's answer and judge spend can be priced from its own record.
+_USAGE_LOG = os.environ.get("OMB_USAGE_LOG")
+_USAGE_LOCK = threading.Lock()
+
+_MAX_ATTEMPTS = 3
+
+
+class AnthropicLLM(LLM):
+    """Claude via the Anthropic Messages API, with structured JSON output.
+
+    Current Claude models reject non-default sampling parameters, so there is no
+    temperature=0 or seed here: repeated runs are not bit-reproducible, and repeats
+    have to be compared as rates. Thinking is the model's default (adaptive);
+    `OMB_<ROLE>_EFFORT` (low|medium|high|xhigh|max) sets its depth per role."""
+
+    def __init__(self, model: str = "claude-haiku-5-5"):
+        import anthropic
+
+        self._client = anthropic.Anthropic(max_retries=6)
+        self._model = model
+        self._role = "llm"
+        self._effort: str | None = None
+
+    def configure(self, role: str) -> None:
+        self._role = role
+        self._effort = os.environ.get(f"OMB_{role.upper()}_EFFORT") or None
+
+    @property
+    def model_id(self) -> str:
+        return f"anthropic:{self._model}" + (f"@{self._effort}" if self._effort else "")
+
+    def generate(self, prompt: str, schema: Schema) -> dict:
+        output_config: dict = {
+            "format": {
+                "type": "json_schema",
+                "schema": {
+                    "type": "object",
+                    "properties": schema.properties,
+                    "required": schema.required,
+                    "additionalProperties": False,
+                },
+            }
+        }
+        if self._effort:
+            output_config["effort"] = self._effort
+        last_problem = ""
+        for attempt in range(_MAX_ATTEMPTS):
+            response = self._client.messages.create(
+                model=self._model,
+                max_tokens=16000,
+                messages=[{"role": "user", "content": prompt}],
+                output_config=output_config,
+            )
+            self._log_usage(response)
+            if response.stop_reason == "refusal":
+                category = getattr(getattr(response, "stop_details", None), "category", None)
+                last_problem = f"refusal ({category})"
+                break  # a refusal repeats; retrying spends the same tokens again
+            text = "".join(b.text for b in response.content if b.type == "text")
